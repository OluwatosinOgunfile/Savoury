SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_AUTH_REDIRECT_URL=http://localhost:5173
# Optional local-only mock customer login. Keep false when using Supabase.
VITE_ENABLE_DEMO_AUTH=false
VITE_PAYSTACK_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=
VITE_STRIPE_PUBLIC_KEY=

# Vercel Blob server-only values. Never add a VITE_ prefix to these.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Do not expose service-role or secret Supabase keys in VITE_ browser variables.

# Local-only account creation script variables. Do not commit real values.
SUPABASE_SERVICE_ROLE_KEY=
SAVOURY_ADMIN_EMAIL=
SAVOURY_ADMIN_PASSWORD=
SAVOURY_POS_EMAIL=
SAVOURY_POS_PASSWORD=
SAVOURY_POS_NAME=
SAVOURY_POS_PHONE=
